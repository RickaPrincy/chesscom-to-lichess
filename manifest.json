{
  "manifest_version": 2,
  "name": "Chess.com → Lichess",
  "version": "1.0.0",
  "description": "Ajoute un bouton sur les parties Chess.com pour les importer et les analyser sur Lichess en un clic.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "tabs",
    "https://www.chess.com/*",
    "https://api.chess.com/*",
    "https://lichess.org/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Analyser cette partie sur Lichess"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chesscom-to-lichess@extension",
      "strict_min_version": "109.0"
    }
  }
}
